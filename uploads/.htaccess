# Защита на папката с качени файлове: никакво изпълнение на скриптове.
php_flag engine off

<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7
RemoveType .php .phtml .php3 .php4 .php5 .php7
